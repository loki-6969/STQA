Step 5: Create Java Class
In Eclipse:
1. Right-click src
2. Select New → Class
3. Class Name:
WebElementInteraction
4. Click Finish. Step 6: Write Java ProgramUse the following simple program:
import java.time.Duration;
import org.openqa.selenium.Alert;
import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.firefox.FirefoxDriver;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.Select;
import org.openqa.selenium.support.ui.WebDriverWait;
public class WebElementInteraction {
 public static void main(String[] args) {
 // Set GeckoDriver path
 System.setProperty("webdriver.gecko.driver",
 "C:\\Users\\DELL\\Downloads\\geckodriver.exe");
 // Open Firefox
 WebDriver driver = new FirefoxDriver();
 // Implicit Wait
 driver.manage().timeouts().implicitlyWait(Duration.ofSeconds(10));
 // Open HTML page
 driver.get("file:///C:/Users/DELL/Desktop/elements.html");
 driver.manage().window().maximize();
 // Explicit Wait
 WebDriverWait wait = new WebDriverWait(driver, Duration.ofSeconds(10)); // 1. Textbox
 WebElement name = wait.until(
 ExpectedConditions.visibilityOfElementLocated(By.id("name"))); name.sendKeys("Aijaz");
 // 2. Radio Button
 driver.findElement(By.xpath("//input[@value='Male']")).click();
 // 3. Checkbox
 driver.findElement(By.id("java")).click();
 // 4. Dropdown
 WebElement course = driver.findElement(By.id("course"));
 Select select = new Select(course);
 select.selectByVisibleText("Information Technology");
 // 5. Alert
 driver.findElement(By.xpath("//button[text()='Show Alert']")).click(); Alert alert = wait.until(
 ExpectedConditions.alertIsPresent());
 System.out.println("Alert Message: " + alert.getText());
 alert.accept();
 // 6. Frame
 driver.switchTo().frame(0);
 WebElement frameText = wait.until(
 ExpectedConditions.visibilityOfElementLocated(
 By.id("frameText")));
 System.out.println("Frame Text: " + frameText.getText());
 // Switch back from frame
 driver.switchTo().defaultContent();
 System.out.println("Test Completed Successfully");
 // Close browser
 driver.quit();
 }
}
